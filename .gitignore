# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Distribution / packaging ---
*.tar.gz
*.whl
.Python

# --- Testing ---
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
.pytest_cache/
.cache/
nosetests.xml

# --- Type checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- Runtime data (git-ignored — generated at runtime) ---
data/

# --- Secrets / environment variables ---
.env
.env.*
!.env.example

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS ---
ehthumbs.db
Desktop.ini
